{
  "title": "Bazaarly Overview",
  "uid": "bazaarly-overview",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (req/s) by service",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (service) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "p95 latency (s) by service",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Events sent to DLQ (total)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "sum by (queue) (events_dlq_total)", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Outbox backlog (unpublished) by service",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "refId": "A", "expr": "outbox_unpublished", "legendFormat": "{{service}}" }]
    }
  ]
}
