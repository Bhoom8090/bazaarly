# Bazaarly environment configuration (copy to .env before running)
NODE_ENV=development

# Secrets
JWT_SECRET=dev_jwt_secret_change_me_in_production_0123456789abcdef
INTERNAL_KEY=dev_internal_key_change_me_0123456789abcdef
PSP_WEBHOOK_SECRET=whsec_dev_mock_secret
PSP_API_KEY=sk_test_mock
COOKIE_SECURE=false

# Seed accounts
ADMIN_EMAIL=admin@bazaarly.test
ADMIN_PASSWORD=Admin@12345
DEMO_EMAIL=demo@bazaarly.test
DEMO_PASSWORD=Demo@12345
ADMIN_MFA_ENFORCE=false
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Behaviour tuning
RESERVATION_TTL_SECONDS=600
EVENT_MAX_ATTEMPTS=5
RATE_LIMIT_PER_MIN=1000
AUTH_RATE_LIMIT_PER_MIN=200
CHECKOUT_RATE_LIMIT_PER_MIN=10
SEARCH_RATE_LIMIT_PER_MIN=120
PAYMENT_SANDBOX=true
MAX_CART_QTY=10

# Infrastructure
# One PostgreSQL container with one database per transactional service.
# The init SQL (infra/postgres-init.sql) creates them on first boot.
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGADMIN_DB=postgres
REDIS_URL=redis://redis:6379
AMQP_URL=amqp://guest:guest@rabbitmq:5672
SMTP_HOST=mailpit
SMTP_PORT=1025
PSP_WEBHOOK_URL=http://gateway:8080/v1/webhooks/payments/mockpsp

# Service base URLs (defaults are applied in shared/config.js if unset)
IDENTITY_URL=http://identity:4001
CATALOG_URL=http://catalog:4002
SEARCH_URL=http://search:4003
INVENTORY_URL=http://inventory:4004
CART_URL=http://cart:4005
ORDER_URL=http://order:4006
PAYMENT_URL=http://payment:4007
NOTIFICATION_URL=http://notification:4008
FULFILMENT_URL=http://fulfilment:4009
MOCK_PSP_URL=http://mock-psp:4010
REPORTING_URL=http://reporting:4011
SYNC_INTERVAL_MS=60000
